import Common.Rules

/-!
# BM1.1: the trace of the source

hyp cos, Talk:Bashicu matrix system, "Still with problems" (2016-05-23).
Each `A reduces to B... (Bad part is …)` line is checked as: `B` is a prefix
of the expansion of `A` with bracket 2, and the bad root is the first column
of the stated bad part.
-/

namespace DeadBms.BM1_1.Ex.Trace

/-- `B` is a prefix of `A[2]` and the bad root of `A` is column `r` -/
def line (A B : Mat) (t r : Nat) : Bool :=
  B.isPrefixOf (expand BM1_1 A 2) && lowestNZ (A.getLast?.getD []) == some t && ubim A t == some r

-- first period
example : line bm[(0,0,0)(1,1,1)(2,0,0)(1,1,1)]
    bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,1,0)] 2 0 := by decide
example : line bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,1,0)]
    bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,0,0)(4,1,1)] 1 0 := by decide
example : line bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,0,0)(4,1,1)]
    bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,0,0)(4,1,0)] 2 5 := by decide
example : line bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,0,0)(4,1,0)]
    bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,0,0)(4,0,0)] 1 5 := by decide
example : line bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,0,0)(4,0,0)]
    bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,0,0)(3,0,0)] 0 5 := by decide
example : line bm[(0,0,0)(1,1,1)(2,0,0)(1,1,0)(2,2,1)(3,0,0)(3,0,0)]
