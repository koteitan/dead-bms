import Common.Rules

/-!
# BM3: the trace of the source

Alemagno12, "BM3 has an infinite loop" (2018-06-29), the part after
"...and then I prove that it doesn't terminate".  `=` lines are expansions
(checked as prefixes, with the bracket shown) and `>` lines are prefixes of
them.

The source writes the third line as `…(7,3,1)(8,1,1)(9,3,0)…`; the
expansion is `…(7,3,1)(8,1,1)(7,3,0)(8,4,1)(9,3,0)…`, so two columns are
missing there.  The prefix up to `(8,1,1)` is checked below.
-/

namespace DeadBms.BM3.Ex.Trace

-- (0,0,0)(1,1,1)(2,1,1)(1,1,1) = (0,0,0)(1,1,1)(2,1,1)(1,1,0)(2,2,1)(3,1,1)(2,2,0)(3,3,1)(4,1,1)(3,3,0)(4,4,1)(5,1,1)...
example : expand BM3 bm[(0,0,0)(1,1,1)(2,1,1)(1,1,1)] 3 =
    bm[(0,0,0)(1,1,1)(2,1,1)(1,1,0)(2,2,1)(3,1,1)(2,2,0)(3,3,1)(4,1,1)(3,3,0)(4,4,1)(5,1,1)] := by
  decide

-- = …(3,1,0)(4,2,1)(5,1,1)(4,2,0)(5,3,1)(6,2,0)(7,3,1)(8,1,1)…
example : bm[(0,0,0)(1,1,1)(2,1,1)(1,1,0)(2,2,1)(3,1,0)(4,2,1)(5,1,1)(4,2,0)(5,3,1)(6,2,0)(7,3,1)(8,1,1)].isPrefixOf
    (expand BM3 bm[(0,0,0)(1,1,1)(2,1,1)(1,1,0)(2,2,1)(3,1,1)] 2) := by decide

-- = …(3,1,0)(4,2,1)(5,1,0)(6,2,1)(7,1,1)(6,2,0)(7,3,1)(8,1,0)(9,2,1)(10,2,0)…
example : bm[(0,0,0)(1,1,1)(2,1,1)(1,1,0)(2,2,1)(3,1,0)(4,2,1)(5,1,0)(6,2,1)(7,1,1)(6,2,0)(7,3,1)(8,1,0)(9,2,1)(10,2,0)].isPrefixOf
    (expand BM3 bm[(0,0,0)(1,1,1)(2,1,1)(1,1,0)(2,2,1)(3,1,0)(4,2,1)(5,1,1)] 2) := by decide

-- = …(5,1,0)(6,2,1)(7,1,0)(8,2,1)(9,1,1)(8,2,0)(9,3,1)(10,1,0)(11,2,1)(12,1,0)(13,2,1)(14,2,0)…
example : bm[(0,0,0)(1,1,1)(2,1,1)(1,1,0)(2,2,1)(3,1,0)(4,2,1)(5,1,0)(6,2,1)(7,1,0)(8,2,1)(9,1,1)(8,2,0)(9,3,1)(10,1,0)(11,2,1)(12,1,0)(13,2,1)(14,2,0)].isPrefixOf
    (expand BM3 bm[(0,0,0)(1,1,1)(2,1,1)(1,1,0)(2,2,1)(3,1,0)(4,2,1)(5,1,0)(6,2,1)(7,1,1)] 2) := by decide

end DeadBms.BM3.Ex.Trace
